{
  "name": "nclaw",
  "version": "1.1.6",
  "private": true,
  "description": "\u0273Claw \u2014 AI assistant monorepo (Tauri 2 desktop + React Native mobile + Rust core)",
  "scripts": {
    "mobile": "pnpm --filter @nclaw/mobile start",
    "mobile:ios": "pnpm --filter @nclaw/mobile ios",
    "mobile:android": "pnpm --filter @nclaw/mobile android",
    "desktop": "pnpm --filter nclaw-desktop dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.1.0",
      "@types/react-dom": "^19.1.0",
      "expo-document-picker": "14.0.0",
      "expo-file-system": "18.0.7",
      "react-native-share-extension": "2.0.0",
      "@op-engineering/op-sqlite": "16.2.2",
      "urql": "5.0.3",
      "@sentry/tracing": "7.120.4",
      "esbuild": "^0.25.12",
      "prismjs": ">=1.30.0",
      "jsondiffpatch": ">=0.7.2",
      "postcss": ">=8.5.18",
      "uuid": ">=11.1.1",
      "js-yaml": ">=4.3.1",
      "@opentelemetry/core": ">=2.8.0",
      "@opentelemetry/sdk-trace-base": ">=2",
      "@opentelemetry/sdk-trace-node": ">=2",
      "@opentelemetry/exporter-zipkin": ">=2",
      "@opentelemetry/resources": ">=2",
      "@xmldom/xmldom": ">=0.8.13",
      "vite": ">=6.4.2",
      "fast-uri": ">=3.1.3",
      "immutable": ">=5.1.8",
      "nanoid": ">=3.3.18",
      "next": ">=15.5.21",
      "sharp": ">=0.35.0",
      "shell-quote": ">=1.9.0",
      "tar": ">=7.5.19",
      "undici": ">=7.29.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@3": "5.0.9",
      "brace-expansion@4": "5.0.9",
      "brace-expansion@5": "5.0.9"
    },
    "auditConfig": {
      "ignoreGhsas": [],
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  }
}
